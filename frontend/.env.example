# CodeJudge frontend 环境变量（照抄为 frontend/.env 填值；真实 .env 一律 gitignore）
# Supabase（留空 = local 模式，全站保持匿名本地行为）
# 注意：前端只允许 sb_publishable_…；sb_secret_ 只放 backend/.env，严禁进前端
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…
# 判题 API 源：留空 = 同源（本地/单端口模式）；GitHub Pages 填自托管后端 HTTPS 源
VITE_API_BASE=
# 路由模式：hash = GitHub Pages 等静态托管；留空 = history 模式
VITE_ROUTER_MODE=hash
