# backend/.env.example —— 后端环境变量占位（真实 .env 一律 gitignore，绝不入库）
# 复制为 backend/.env 后填值；留空 = local 模式（不校验 JWT、不写云端）

# ── Supabase（Δ3 用户系统）────────────────────────────────────
# 项目 URL（与前端 VITE_SUPABASE_URL 同源，但后端环境独立读取）
SUPABASE_URL=
# 新一代 secret 密钥（形如 sb_secret_…）：仅后端使用
# 🔴 安全红线：sb_secret_ 绝不进前端产物 / 仓库 / 日志——泄漏 = 全库失守
# 只在 Supabase → Project Settings → API Keys 取新一代两把；严禁混用旧 anon / service_role JWT
SUPABASE_SECRET_KEY=
# CORS 白名单（逗号分隔），如 https://<user>.github.io,http://localhost:5173,http://127.0.0.1:5173
# 留空 = 不限制（本地现状）
JUDGE_CORS_ORIGINS=

# ── 判题服务（既有）──────────────────────────────────────────
JUDGE_HOST=127.0.0.1
JUDGE_PORT=8000
JUDGE_REPORTS_DIR=reports
JUDGE_MAX_SUBMIT_SECONDS=120

# ── 密钥体系备忘（site-spec 13.3）────────────────────────────
# VITE_SUPABASE_PUBLISHABLE_KEY（形如 sb_publishable_…）是【前端】用的 publishable key，
# 配在 frontend/.env，可进构建产物；与本文件的 sb_secret_ 严禁混用或互换。
